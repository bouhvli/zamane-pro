{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zamane",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // One origin: static assets for the SPA; only /api/* runs Worker code (§1).
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // Local `vite dev` reads secrets from .env (D20). The list limits which .env keys are declared for the Worker.
  "secrets": {
    "required": [
      "DATABASE_URL",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "APP_URL",
      "EMAIL_FROM",
      "RESEND_API_KEY",
      "CLOUDINARY_CLOUD_NAME",
      "CLOUDINARY_API_KEY",
      "CLOUDINARY_API_SECRET",
    ],
  },
  "vars": {
    "APP_ENV": "development",
  },
  // Workers Rate Limiting binding (D26). Periods must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_JOIN", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_REALTIME", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
  ],
  "env": {
    "production": {
      "vars": {
        "APP_ENV": "production",
        // Set the real origin before the first deploy (follow-up in ARCHITECTURE.md).
        "APP_URL": "https://zamane.example",
        "EMAIL_FROM": "Zamane <hello@zamane.example>",
        "CLOUDINARY_CLOUD_NAME": "",
      },
      "secrets": {
        "required": ["DATABASE_URL", "BETTER_AUTH_SECRET", "RESEND_API_KEY"],
      },
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_JOIN", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_REALTIME", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } },
      ],
    },
  },
}
