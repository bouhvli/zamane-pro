# Zamane — local configuration (§10 of ARCHITECTURE.md). Copy to .env and fill in. Never commit .env.
# `vite dev` loads .env straight into the Worker's bindings (D20); only the keys listed under
# "secrets.required" in wrangler.jsonc reach the Worker. There must be no .dev.vars file in the project root.
# NODE_ENV does not belong here: the Worker's environment comes from APP_ENV in wrangler.jsonc.

# Neon Postgres, the DIRECT (unpooled) endpoint of your dev branch, with sslmode=require (D32). No "-pooler" host.
DATABASE_URL=

# At least 32 random bytes. `pnpm env:init` generates one into .env without printing it.
BETTER_AUTH_SECRET=

# The public origin. Locally: http://localhost:3000 (the dev server's port, D21).
APP_URL=http://localhost:3000

# Password-reset email through Resend. Empty locally: the reset link is then printed to the dev server console
# (never returned in an HTTP response). The sender is chosen by the app (D45): onboarding@resend.dev locally,
# which only delivers to your Resend account's own address; no-reply@<APP_URL domain> elsewhere, which must be
# a domain verified in Resend.
RESEND_API_KEY=

# Cloudinary: all three or none. All empty disables uploads (the app hides upload controls).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neon API, used by the database guard (scripts/db-guard.ts) to check that DATABASE_URL is not the main,
# default or a protected branch before seeding or destructive migrations. Without it the guard refuses.
NEON_API_KEY=
NEON_PROJECT_ID=
