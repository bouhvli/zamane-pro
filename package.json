{
  "name": "zamane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build && tsx scripts/build-vercel.ts",
    "preview": "tsx scripts/preview.ts",
    "deploy": "pnpm build && vercel deploy --prebuilt --prod",
    "env:init": "tsx scripts/env-init.ts",
    "icons": "tsx scripts/icons.ts",
    "tokens": "tsx scripts/tokens.ts",
    "tokens:check": "tsx scripts/tokens.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "tsx scripts/db-guard.ts && drizzle-kit studio",
    "test": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "images:orphans": "tsx scripts/images-orphans.ts",
    "check:secrets": "tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@hono/node-server": "2.1.7",
    "@hono/zod-validator": "0.9.1",
    "@hookform/resolvers": "7.0.5",
    "@neondatabase/serverless": "1.2.0",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@vercel/functions": "3.11.1",
    "better-auth": "1.7.18",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.17",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "uuid": "14.0.3",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tanstack/router-plugin": "1.169.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
